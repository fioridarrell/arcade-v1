#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if ! getent passwd arcade >/dev/null; then
        adduser --system --group --home /var/lib/arcade --no-create-home arcade
    fi
    # Let the installing desktop user talk to the service (CLI and desktop app).
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
        adduser "$SUDO_USER" arcade >/dev/null || true
    fi
    systemctl daemon-reload || true
    systemctl enable --now arcaded.service || true
    echo
    echo "Arcade V1.0 is installed and running."
    echo "Finish the first-time setup (mesh, chain, wallet, your @handle) with:"
    echo
    echo "    arcade setup"
    echo
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
        echo "($SUDO_USER was added to the 'arcade' group so the CLI and the Arcade app can reach"
        echo " the service: log out and back in once, or run  newgrp arcade  in this terminal.)"
        echo
    fi
fi
